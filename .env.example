# Use a long random value (at least 32 characters) in every deployed environment.
JWT_SECRET=

# Sepolia JSON-RPC endpoint. Required for live contract reads and transaction validation.
SEPOLIA_RPC_URL=

# Optional server wallet used only to create escrow clones through EscrowFactory.
# Client/freelancer actions are always signed by their connected wallet.
CHAIN_RELAYER_PRIVATE_KEY=

# Populated by `npm run contracts:export-addresses` after deployment.
ESCROW_FACTORY_ADDRESS=
